{
  "name": "minimarket-root",
  "private": true,
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.3"
  },
  "scripts": {
    "start": "cd app && npm start",
    "backend": "cd minimarket-app/electron && node server.js",
    "dev": "concurrently \"npm run backend\" \"npm start\"",
    "electron-dev": "concurrently \"npm run backend\" \"cd minimarket-app/electron && set ELECTRON_DEV=true && electron .\"",
    "dev-all": "concurrently \"cd app && npm start\" \"cd backend && python manage.py runserver\" \"wait-on tcp:3000 && cd backend/electron && set ELECTRON_DEV=true && electron .\"",
    "build": "cd app && npm run build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.minimarket.app",
    "productName": "MinimarketApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/build/**/*",
      "app/public/electron.js",
      "app/public/favicon.ico",
      "minimarket-app/electron/**/*",
      "backend/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "sign": false
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mercadopago": "^2.10.0",
    "react-chartjs-2": "^5.3.1",
    "transbank-sdk": "^6.1.0"
  }
}
